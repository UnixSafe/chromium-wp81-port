+#include <vector>
+
+#include "third_party/skia/include/core/SkCanvas.h"
+#include "third_party/skia/include/core/SkFont.h"
+#include "url/gurl.h"
+
+namespace content {
+
+// The Phone CoreWindow has no XAML text box. Keep browser-owned input separate
+// from the document so a page cannot intercept address entry or the Go action.
+class PhoneNavigation {
+ public:
+  static constexpr int kHeight = 44;
+  enum class Action { kNone, kBack, kReload, kNavigate };
+  struct Result {
+    Action action = Action::kNone;
+    GURL url;
+  };
+
+  PhoneNavigation();
+  void SetLocation(const GURL& location);
+  bool OwnsPoint(float y) const { return editing_ || y < kHeight; }
+  Result Tap(int x, int y, int width, int height);
+  Result Character(unsigned character);
+  bool editing() const { return editing_; }
+  void Draw(SkCanvas& canvas, int width, int height) const;
+
+ private:
+  struct Key {
+    SkRect rect;
+    std::string label;
+  };
+  std::vector<Key> Keys(int width, int height) const;
+  Result Apply(std::string_view key);
+  Result Submit();
+  GURL location_;
+  std::string text_;
+  bool editing_ = false;
+  bool replace_on_type_ = false;
+  bool shift_ = false;
+  bool symbols_ = false;
+  bool invalid_ = false;
+  SkFont font_;
+};
+}  // namespace content
+#endif
