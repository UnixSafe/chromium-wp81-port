+                   ui::EventType type,
+                   EventRegistrationToken* token);
+  Microsoft::WRL::ComPtr<ABI::Windows::UI::Core::ICoreWindow> window_;
+  Callback callback_;
+  CharacterCallback character_callback_;
+  EventRegistrationToken character_token_{};
