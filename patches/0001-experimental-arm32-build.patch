+// found in the LICENSE file.
+
+// Windows Phone 8.1 declarations for V8's Win32 platform layer.
+//
+// The Phone 8.1 kernel exports these functions through WindowsPhoneCore.lib,
+// but the application-family SDK headers hide their declarations. Each one
+// below was checked against the exports of the real Phone 8.1 ARM import
+// library. Include this header after <windows.h>.
+
+#ifndef V8_BASE_PLATFORM_WIN32_PHONE81_H_
+#define V8_BASE_PLATFORM_WIN32_PHONE81_H_
+
+#include <windows.h>
+
+#if defined(WINAPI_FAMILY) && defined(WINAPI_FAMILY_PHONE_APP) && \
+    WINAPI_FAMILY == WINAPI_FAMILY_PHONE_APP
+
+#define V8_OS_WINPHONE81 1
+
+extern "C" {
+
+typedef struct _MEMORYSTATUSEX {
+  DWORD dwLength;
+  DWORD dwMemoryLoad;
+  DWORDLONG ullTotalPhys;
+  DWORDLONG ullAvailPhys;
+  DWORDLONG ullTotalPageFile;
+  DWORDLONG ullAvailPageFile;
+  DWORDLONG ullTotalVirtual;
+  DWORDLONG ullAvailVirtual;
+  DWORDLONG ullAvailExtendedVirtual;
+} MEMORYSTATUSEX, *LPMEMORYSTATUSEX;
+
+__declspec(dllimport) BOOL WINAPI GlobalMemoryStatusEx(LPMEMORYSTATUSEX);
+__declspec(dllimport) VOID WINAPI GetSystemInfo(LPSYSTEM_INFO);
+__declspec(dllimport) DWORD WINAPI WaitForSingleObject(HANDLE, DWORD);
+__declspec(dllimport) BOOL WINAPI FlushInstructionCache(HANDLE, LPCVOID,
+                                                        SIZE_T);
+__declspec(dllimport) BOOL WINAPI GetThreadTimes(HANDLE, LPFILETIME,
+                                                 LPFILETIME, LPFILETIME,
+                                                 LPFILETIME);
+__declspec(dllimport) DWORD WINAPI SuspendThread(HANDLE);
+__declspec(dllimport) DWORD WINAPI ResumeThread(HANDLE);
+__declspec(dllimport) BOOL WINAPI GetThreadContext(HANDLE, LPCONTEXT);
+__declspec(dllimport) HMODULE WINAPI GetModuleHandleW(LPCWSTR);
+__declspec(dllimport) BOOL WINAPI TerminateProcess(HANDLE, UINT);
+// Exported by the VC120 Store CRT (msvcr120_app.dll); the UCRT headers used
+// for compilation hide it from application builds.
+__declspec(dllimport) void __cdecl _tzset(void);
+__declspec(dllimport) LPVOID WINAPI VirtualAlloc(LPVOID, SIZE_T, DWORD, DWORD);
+__declspec(dllimport) BOOL WINAPI VirtualFree(LPVOID, SIZE_T, DWORD);
+__declspec(dllimport) BOOL WINAPI VirtualProtect(LPVOID, SIZE_T, DWORD,
+                                                 PDWORD);
+__declspec(dllimport) SIZE_T WINAPI VirtualQuery(LPCVOID,
+                                                 PMEMORY_BASIC_INFORMATION,
+                                                 SIZE_T);
+__declspec(dllimport) HANDLE WINAPI CreateFileMappingW(HANDLE,
+                                                       LPSECURITY_ATTRIBUTES,
+                                                       DWORD, DWORD, DWORD,
+                                                       LPCWSTR);
+__declspec(dllimport) LPVOID WINAPI MapViewOfFile(HANDLE, DWORD, DWORD, DWORD,
+                                                  SIZE_T);
+__declspec(dllimport) LPVOID WINAPI MapViewOfFileEx(HANDLE, DWORD, DWORD,
+                                                    DWORD, SIZE_T, LPVOID);
+__declspec(dllimport) BOOL WINAPI UnmapViewOfFile(LPCVOID);
+typedef VOID(CALLBACK* PTIMERAPCROUTINE)(LPVOID, DWORD, DWORD);
+__declspec(dllimport) HANDLE WINAPI CreateWaitableTimerExW(
+    LPSECURITY_ATTRIBUTES, LPCWSTR, DWORD, DWORD);
+__declspec(dllimport) BOOL WINAPI SetWaitableTimer(HANDLE,
+                                                   const LARGE_INTEGER*, LONG,
+                                                   PTIMERAPCROUTINE, LPVOID,
+                                                   BOOL);
+__declspec(dllimport) HANDLE WINAPI CreateFileW(LPCWSTR, DWORD, DWORD,
+                                                LPSECURITY_ATTRIBUTES, DWORD,
+                                                DWORD, HANDLE);
+__declspec(dllimport) DWORD WINAPI GetFileSize(HANDLE, LPDWORD);
+__declspec(dllimport) UINT WINAPI SetErrorMode(UINT);
+
+}  // extern "C"
+
+#ifndef GetModuleHandle
+#define GetModuleHandle GetModuleHandleW
+#endif
+#ifndef CreateFileMapping
+#define CreateFileMapping CreateFileMappingW
+#endif
+
+// Executable page protections (winnt.h hides them from application builds).
+// V8 lite/jitless mode never requests executable memory at run time.
+#ifndef PAGE_EXECUTE
+#define PAGE_EXECUTE 0x10
+#endif
+#ifndef PAGE_EXECUTE_READ
+#define PAGE_EXECUTE_READ 0x20
+#endif
+#ifndef PAGE_EXECUTE_READWRITE
+#define PAGE_EXECUTE_READWRITE 0x40
+#endif
+
+// Windows 10 memory-placeholder API types and flags. VirtualAlloc2 and
+// MapViewOfFile3 do not exist on Phone 8.1, so V8 finds them missing at run
+// time and never passes these values to the kernel.
+#ifndef MEM_RESERVE_PLACEHOLDER
+typedef struct MEM_EXTENDED_PARAMETER {
+  struct {
+    DWORD64 Type : 8;
+    DWORD64 Reserved : 56;
+  };
+  union {
+    DWORD64 ULong64;
+    PVOID Pointer;
+    SIZE_T Size;
+    HANDLE Handle;
+    DWORD ULong;
+  };
+} MEM_EXTENDED_PARAMETER, *PMEM_EXTENDED_PARAMETER;
+#define MEM_COALESCE_PLACEHOLDERS 0x00000001
+#define MEM_PRESERVE_PLACEHOLDER 0x00000002
+#define MEM_REPLACE_PLACEHOLDER 0x00004000
+#define MEM_RESERVE_PLACEHOLDER 0x00040000
+#endif
+#ifndef PAGE_TARGETS_INVALID
+#define PAGE_TARGETS_INVALID 0x40000000
+#endif
+
+// Windows 10 1803 flag: CreateWaitableTimerExW rejects it on Phone 8.1 and
+// V8 then falls back to its regular sleep.
+#ifndef CREATE_WAITABLE_TIMER_HIGH_RESOLUTION
+#define CREATE_WAITABLE_TIMER_HIGH_RESOLUTION 0x00000002
+#endif
+#ifndef SEM_FAILCRITICALERRORS
+#define SEM_FAILCRITICALERRORS 0x0001
+#define SEM_NOGPFAULTERRORBOX 0x0002
+#define SEM_NOOPENFILEERRORBOX 0x8000
+#endif
+
+// VersionHelpers.h is desktop-only; the phone runs Windows Phone 8.1.
+inline bool IsWindows10OrGreater() { return false; }
+
+#endif  // WINAPI_FAMILY == WINAPI_FAMILY_PHONE_APP
+
+#endif  // V8_BASE_PLATFORM_WIN32_PHONE81_H_
