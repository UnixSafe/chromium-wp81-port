+// getaddrinfo also accepts historical IPv4 forms such as "127.1" and octal
+// octets. Require four decimal octets for parity with inet_pton.
+bool IsDottedQuad(std::string_view input) {
+  for (int i = 0; i < 4; ++i) {
+    size_t end = input.find('.');
+    auto octet = input.substr(0, end);
+    if (octet.empty() || octet.size() > 3 ||
+        (octet.size() > 1 && octet.front() == '0') ||
+        octet.find_first_not_of("0123456789") != std::string_view::npos ||
+        (octet.size() == 3 && octet > "255") ||
+        ((i == 3) != (end == std::string_view::npos))) {
+      return false;
+    }
+    if (i < 3) input.remove_prefix(end + 1);
+  }
+  return true;
+}
