@@ -0,0 +1,96 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+struct IUnknown;
+#include "content/shell/browser/shell_phone_touch.h"
+
+#include <windows.ui.input.h>
+#include <wrl/event.h>
+
+#include <utility>
+
+#include "base/check.h"
+#include "base/win/windows_types.h"
+
+namespace content {
+namespace core = ABI::Windows::UI::Core;
+namespace foundation = ABI::Windows::Foundation;
+using Microsoft::WRL::ComPtr;
+using PointerHandler =
+    foundation::ITypedEventHandler<core::CoreWindow*, core::PointerEventArgs*>;
+
+template <typename Registration>
+void PhoneTouchInput::BindPointer(Registration registration,
+                                  ui::EventType type,
+                                  EventRegistrationToken* token) {
+  auto handler = Microsoft::WRL::Callback<PointerHandler>(
+      [this, type](core::ICoreWindow*, core::IPointerEventArgs* args) {
+        ComPtr<ABI::Windows::UI::Input::IPointerPoint> point;
+        UINT32 id;
+        foundation::Point position;
+        if (FAILED(args->get_CurrentPoint(&point)) ||
+            FAILED(point->get_PointerId(&id)) ||
+            FAILED(point->get_Position(&position))) {
+          return S_OK;
+        }
+        if (type == ui::EventType::kTouchPressed) {
+          if (!contacts_.insert(id).second) {
+            return S_OK;
+          }
+        } else if (!contacts_.contains(id)) {
+          return S_OK;
+        } else if (type != ui::EventType::kTouchMoved) {
+          contacts_.erase(id);
+        }
+        ComPtr<core::ICoreWindowEventArgs> common;
+        if (SUCCEEDED(args->QueryInterface(IID_PPV_ARGS(&common)))) {
+          common->put_Handled(true);
+        }
+        callback_.Run(type, id, position.X, position.Y);
+        return S_OK;
+      });
+  CHECK(handler &&
+        SUCCEEDED((window_.Get()->*registration)(handler.Get(), token)));
+}
+
+PhoneTouchInput::PhoneTouchInput(core::ICoreWindow* window,
+                                 Callback callback,
+                                 CharacterCallback character_callback)
+    : window_(window),
+      callback_(std::move(callback)),
+      character_callback_(std::move(character_callback)) {
+  using Handler =
+      foundation::ITypedEventHandler<core::CoreWindow*,
+                                     core::CharacterReceivedEventArgs*>;
+  auto handler = Microsoft::WRL::Callback<Handler>(
+      [this](core::ICoreWindow*, core::ICharacterReceivedEventArgs* args) {
+        UINT32 code;
+        if (SUCCEEDED(args->get_KeyCode(&code)) &&
+            character_callback_.Run(code)) {
+          ComPtr<core::ICoreWindowEventArgs> common;
+          if (SUCCEEDED(args->QueryInterface(IID_PPV_ARGS(&common)))) {
+            common->put_Handled(true);
+          }
+        }
+        return S_OK;
+      });
+  CHECK(handler && SUCCEEDED(window_->add_CharacterReceived(
+                       handler.Get(), &character_token_)));
+  BindPointer(&core::ICoreWindow::add_PointerPressed,
+              ui::EventType::kTouchPressed, &pressed_);
+  BindPointer(&core::ICoreWindow::add_PointerMoved, ui::EventType::kTouchMoved,
+              &moved_);
+  BindPointer(&core::ICoreWindow::add_PointerReleased,
+              ui::EventType::kTouchReleased, &released_);
+  BindPointer(&core::ICoreWindow::add_PointerCaptureLost,
+              ui::EventType::kTouchCancelled, &lost_);
+}
+PhoneTouchInput::~PhoneTouchInput() {
+  window_->remove_CharacterReceived(character_token_);
+  window_->remove_PointerPressed(pressed_);
+  window_->remove_PointerMoved(moved_);
+  window_->remove_PointerReleased(released_);
+  window_->remove_PointerCaptureLost(lost_);
+}
+}  // namespace content
