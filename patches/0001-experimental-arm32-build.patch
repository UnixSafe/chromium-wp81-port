+class PhoneTouchInput {
+ public:
+  using Callback =
+      base::RepeatingCallback<void(ui::EventType, UINT32, float, float)>;
+  using CharacterCallback = base::RepeatingCallback<bool(UINT32)>;
+  PhoneTouchInput(ABI::Windows::UI::Core::ICoreWindow* window,
+                  Callback callback,
