+  if (FAILED(profile->QueryInterface(IID_PPV_ARGS(&profile2))) ||
+      FAILED(profile2->get_WwanConnectionProfileDetails(&mobile)) || !mobile ||
+      FAILED(mobile->GetCurrentDataClass(&data))) {
+    return N::CONNECTION_UNKNOWN;
+  }
+  if (data & WwanDataClass_LteAdvanced) {
+    return N::CONNECTION_4G;
+  }
+  if (data & (WwanDataClass_Umts | WwanDataClass_Hsdpa | WwanDataClass_Hsupa |
+              WwanDataClass_Cdma1xEvdo | WwanDataClass_Cdma1xEvdoRevA |
+              WwanDataClass_Cdma1xEvdoRevB | WwanDataClass_Cdma1xEvdv |
+              WwanDataClass_Cdma3xRtt | WwanDataClass_CdmaUmb)) {
+    return N::CONNECTION_3G;
+  }
+  if (data &
+      (WwanDataClass_Gprs | WwanDataClass_Edge | WwanDataClass_Cdma1xRtt)) {
+    return N::CONNECTION_2G;
+  }
+  return N::CONNECTION_UNKNOWN;
+}
+
+N::ConnectionCost ProfileCost(IConnectionProfile* profile) {
+  ComPtr<IConnectionCost> cost;
+  NetworkCostType kind;
+  if (FAILED(profile->GetConnectionCost(&cost)) || !cost ||
+      FAILED(cost->get_NetworkCostType(&kind))) {
+    return N::CONNECTION_COST_UNKNOWN;
+  }
+  if (kind == NetworkCostType_Unrestricted) {
+    return N::CONNECTION_COST_UNMETERED;
+  }
+  if (kind == NetworkCostType_Variable || kind == NetworkCostType_Fixed) {
+    return N::CONNECTION_COST_METERED;
+  }
+  return N::CONNECTION_COST_UNKNOWN;
+}
+}  // namespace
+
+struct NetworkChangeNotifierPhone::Subscription {
+  phone::NetworkApartment apartment;
+  ComPtr<INetworkInformationStatics> info;
+  EventRegistrationToken token{};
+  bool subscribed = false;
+
+  ~Subscription() {
+    if (subscribed) {
+      info->remove_NetworkStatusChanged(token);
+    }
+  }
+};
+
+NetworkChangeNotifierPhone::NetworkChangeNotifierPhone() {
+  Refresh(false);
+}
+
+NetworkChangeNotifierPhone::~NetworkChangeNotifierPhone() {
+  ClearGlobalPointer();
+}
+
+void NetworkChangeNotifierPhone::Refresh(bool status_event) {
+  if (!subscription_ || !subscription_->apartment.ready()) {
+    subscription_ = std::make_unique<Subscription>();
+  }
+  auto& state = *subscription_;
+  if (state.apartment.ready() && !state.info) {
+    state.info = phone::NetworkInformation();
+  }
+  if (state.info && !state.subscribed) {
+    auto handler = Microsoft::WRL::Callback<INetworkStatusChangedEventHandler>(
+        [runner = base::SingleThreadTaskRunner::GetCurrentDefault(),
+         weak = weak_factory_.GetWeakPtr()](IInspectable*) -> HRESULT {
+          runner->PostTask(
+              FROM_HERE,
+              base::BindOnce(&NetworkChangeNotifierPhone::Refresh, weak, true));
+          return S_OK;
+        });
+    state.subscribed =
+        handler && SUCCEEDED(state.info->add_NetworkStatusChanged(
+                       handler.Get(), &state.token));
+  }
+
+  ConnectionType type = CONNECTION_UNKNOWN;
+  ConnectionCost cost = CONNECTION_COST_UNKNOWN;
+  ComPtr<IConnectionProfile> profile;
+  bool queried = state.info &&
+                 SUCCEEDED(state.info->GetInternetConnectionProfile(&profile));
+  if (queried && !profile) {
+    type = CONNECTION_NONE;
+  } else if (queried) {
+    NetworkConnectivityLevel level;
+    queried = SUCCEEDED(profile->GetNetworkConnectivityLevel(&level));
+    if (queried) {
+      type = level == NetworkConnectivityLevel_None
+                 ? CONNECTION_NONE
+                 : ProfileType(profile.Get());
+      cost = ProfileCost(profile.Get());
+    }
+  }
+
+  bool type_changed = type_.exchange(type) != type;
+  bool cost_changed = cost_.exchange(cost) != cost;
+  if (status_event || type_changed) {
+    NotifyObserversOfIPAddressChange();
+  }
+  if (type_changed) {
+    NotifyObserversOfConnectionTypeChange();
+    double bandwidth;
+    ConnectionType bandwidth_type;
+    GetMaxBandwidthAndConnectionType(&bandwidth, &bandwidth_type);
+    NotifyObserversOfMaxBandwidthChange(bandwidth, bandwidth_type);
+  }
+  if (cost_changed) {
+    NotifyObserversOfConnectionCostChange();
+  }
+  if (!queried || !state.subscribed) {
+    if (!queried) {
+      // Retry activation and subscription after a disconnected WinRT factory.
+      profile.Reset();
+      subscription_.reset();
+    }
+    retry_.Start(FROM_HERE, base::Seconds(10),
+                 base::BindOnce(&NetworkChangeNotifierPhone::Refresh,
+                                weak_factory_.GetWeakPtr(), false));
+  } else {
+    retry_.Stop();
+  }
+}
+
+NetworkChangeNotifier::ConnectionType
+NetworkChangeNotifierPhone::GetCurrentConnectionType() const {
+  return type_.load();
+}
+
+NetworkChangeNotifier::ConnectionCost
+NetworkChangeNotifierPhone::GetCurrentConnectionCost() {
+  return cost_.load();
+}
+}  // namespace net
