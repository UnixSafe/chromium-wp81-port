new file mode 100644
index 0000000..1dfc1e6
--- /dev/null
+++ b/content/shell/browser/shell_phone_presenter.cc
@@ -0,0 +1,83 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+struct IUnknown;
+#include "content/shell/browser/shell_phone_presenter.h"
+
+namespace content {
+using Microsoft::WRL::ComPtr;
+
+HRESULT PhoneFramePresenter::Submit(IUnknown* window,
+                                    UINT width,
+                                    UINT height,
+                                    const void* pixels,
+                                    UINT row_bytes) {
+  HRESULT hr = Present(window, width, height, pixels, row_bytes);
+  if (hr == DXGI_ERROR_DEVICE_REMOVED || hr == DXGI_ERROR_DEVICE_RESET) {
+    chain_.Reset();
+    context_.Reset();
+    device_.Reset();
+  }
+  return hr;
+}
+
+HRESULT PhoneFramePresenter::Present(IUnknown* window,
+                                     UINT width,
+                                     UINT height,
+                                     const void* pixels,
+                                     UINT row_bytes) {
+  if (!device_) {
+    HRESULT hr =
+        D3D11CreateDevice(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr,
+                          D3D11_CREATE_DEVICE_BGRA_SUPPORT, nullptr, 0,
+                          D3D11_SDK_VERSION, &device_, nullptr, &context_);
+    if (FAILED(hr)) {
+      return hr;
+    }
+  }
+  if (!chain_ || width_ != width || height_ != height) {
+    if (chain_) {
+      HRESULT hr = chain_->ResizeBuffers(2, width, height,
+                                         DXGI_FORMAT_B8G8R8A8_UNORM, 0);
+      if (FAILED(hr)) {
+        return hr;
+      }
+    } else {
+      ComPtr<IDXGIDevice> dxgi;
+      ComPtr<IDXGIAdapter> adapter;
+      ComPtr<IDXGIFactory2> factory;
+      HRESULT hr = device_.As(&dxgi);
+      if (FAILED(hr) || FAILED(hr = dxgi->GetAdapter(&adapter)) ||
+          FAILED(hr = adapter->GetParent(IID_PPV_ARGS(&factory)))) {
+        return hr;
+      }
+      DXGI_SWAP_CHAIN_DESC1 desc{};
+      desc.Width = width;
+      desc.Height = height;
+      desc.Format = DXGI_FORMAT_B8G8R8A8_UNORM;
+      desc.SampleDesc.Count = 1;
+      desc.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+      desc.BufferCount = 2;
+      desc.Scaling = DXGI_SCALING_STRETCH;
+      desc.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+      desc.AlphaMode = DXGI_ALPHA_MODE_IGNORE;
+      hr = factory->CreateSwapChainForCoreWindow(device_.Get(), window, &desc,
+                                                 nullptr, &chain_);
+      if (FAILED(hr)) {
+        return hr;
+      }
+    }
+    width_ = width;
+    height_ = height;
+  }
+  ComPtr<ID3D11Texture2D> back;
+  HRESULT hr = chain_->GetBuffer(0, IID_PPV_ARGS(&back));
+  if (FAILED(hr)) {
+    return hr;
+  }
+  context_->UpdateSubresource(back.Get(), 0, nullptr, pixels, row_bytes, 0);
+  return chain_->Present(1, 0);
+}
+
+}  // namespace content
