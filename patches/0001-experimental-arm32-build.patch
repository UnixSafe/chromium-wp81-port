diff --git a/ui/gfx/win/phone_font_manager.cc b/ui/gfx/win/phone_font_manager.cc
new file mode 100644
index 0000000..d63d5ec
--- /dev/null
+++ b/ui/gfx/win/phone_font_manager.cc
@@ -0,0 +1,213 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/gfx/win/phone_font_manager.h"
+
+#include <wrl/client.h>
+
+#include <limits>
+#include <utility>
+
+#include "base/strings/utf_string_conversions.h"
+#include "third_party/skia/include/core/SkData.h"
+#include "third_party/skia/include/core/SkStream.h"
+#include "third_party/skia/include/core/SkString.h"
+#include "third_party/skia/include/core/SkTypeface.h"
+#include "third_party/skia/include/ports/SkFontMgr_Fontations.h"
+#include "ui/gfx/win/direct_write.h"
+
+namespace gfx::win {
+namespace {
+using Microsoft::WRL::ComPtr;
+
+// Keep the DirectWrite fragment valid until Fontations releases the font.
+struct Fragment {
+  ComPtr<IDWriteFontFileStream> stream;
+  void* token;
+  ~Fragment() { stream->ReleaseFileFragment(token); }
+};
+
+sk_sp<SkTypeface> Open(IDWriteFont* font, SkFontMgr* decoder) {
+  ComPtr<IDWriteFontFace> face;
+  UINT32 count = 0;
+  if (FAILED(font->CreateFontFace(&face)) ||
+      FAILED(face->GetFiles(&count, nullptr)) || count != 1) {
+    return nullptr;
+  }
+  ComPtr<IDWriteFontFile> file;
+  if (FAILED(face->GetFiles(&count, file.GetAddressOf()))) {
+    return nullptr;
+  }
+  const void* key;
+  UINT32 key_size;
+  ComPtr<IDWriteFontFileLoader> loader;
+  ComPtr<IDWriteFontFileStream> stream;
+  UINT64 size;
+  if (FAILED(file->GetReferenceKey(&key, &key_size)) ||
+      FAILED(file->GetLoader(&loader)) ||
+      FAILED(loader->CreateStreamFromKey(key, key_size, &stream)) ||
+      FAILED(stream->GetFileSize(&size)) || !size ||
+      size > std::numeric_limits<size_t>::max()) {
+    return nullptr;
+  }
+  const void* data;
+  void* token;
+  if (FAILED(stream->ReadFileFragment(&data, 0, size, &token))) {
+    return nullptr;
+  }
+  auto bytes = SkData::MakeWithProc(
+      data, static_cast<size_t>(size),
+      [](const void*, void* ctx) { delete static_cast<Fragment*>(ctx); },
+      new Fragment{std::move(stream), token});
+  return decoder->makeFromData(std::move(bytes), face->GetIndex());
+}
+
+class Styles final : public SkFontStyleSet {
+ public:
+  Styles(ComPtr<IDWriteFontFamily> family, sk_sp<SkFontMgr> decoder)
+      : family_(std::move(family)), decoder_(std::move(decoder)) {}
+  int count() override { return family_->GetFontCount(); }
+  void getStyle(int i, SkFontStyle* style, SkString* name) override {
+    ComPtr<IDWriteFont> font;
+    if (FAILED(family_->GetFont(i, &font))) {
+      return;
+    }
+    if (style) {
+      auto slant = font->GetStyle();
+      *style = SkFontStyle(
+          font->GetWeight(), font->GetStretch(),
+          slant == DWRITE_FONT_STYLE_NORMAL   ? SkFontStyle::kUpright_Slant
+          : slant == DWRITE_FONT_STYLE_ITALIC ? SkFontStyle::kItalic_Slant
+                                              : SkFontStyle::kOblique_Slant);
+    }
+    ComPtr<IDWriteLocalizedStrings> names;
+    if (name && SUCCEEDED(font->GetFaceNames(&names))) {
+      name->set(RetrieveLocalizedString(names.Get(), "").value_or("").c_str());
+    }
+  }
+  sk_sp<SkTypeface> createTypeface(int i) override {
+    ComPtr<IDWriteFont> font;
+    return SUCCEEDED(family_->GetFont(i, &font))
+               ? Open(font.Get(), decoder_.get())
+               : nullptr;
+  }
+  sk_sp<SkTypeface> matchStyle(const SkFontStyle& style) override {
+    return matchStyleCSS3(style);
+  }
+
+ private:
+  ComPtr<IDWriteFontFamily> family_;
+  sk_sp<SkFontMgr> decoder_;
+};
+
+class Manager final : public SkFontMgr {
+ public:
+  explicit Manager(ComPtr<IDWriteFontCollection> collection)
+      : collection_(std::move(collection)),
+        decoder_(SkFontMgr_New_Fontations_Empty()) {}
+
+ private:
+  int onCountFamilies() const override {
+    return collection_->GetFontFamilyCount();
+  }
+  void onGetFamilyName(int i, SkString* name) const override {
+    ComPtr<IDWriteFontFamily> family;
+    ComPtr<IDWriteLocalizedStrings> names;
+    if (SUCCEEDED(collection_->GetFontFamily(i, &family)) &&
+        SUCCEEDED(family->GetFamilyNames(&names))) {
+      name->set(RetrieveLocalizedString(names.Get(), "").value_or("").c_str());
+    }
+  }
+  sk_sp<SkFontStyleSet> onCreateStyleSet(int i) const override {
+    ComPtr<IDWriteFontFamily> family;
+    if (FAILED(collection_->GetFontFamily(i, &family))) {
+      return nullptr;
+    }
+    return sk_make_sp<Styles>(std::move(family), decoder_);
+  }
+  sk_sp<SkFontStyleSet> onMatchFamily(const char* name) const override {
+    UINT32 index;
+    BOOL exists;
+    auto wide = base::UTF8ToWide(name ? name : "Segoe WP");
+    if (FAILED(collection_->FindFamilyName(wide.c_str(), &index, &exists)) ||
+        !exists) {
+      if (name || !onCountFamilies()) {
+        return nullptr;
+      }
+      index = 0;
+    }
+    return onCreateStyleSet(index);
+  }
+  sk_sp<SkTypeface> onMatchFamilyStyle(
+      const char* name,
+      const SkFontStyle& style) const override {
+    auto set = onMatchFamily(name);
+    return set ? set->matchStyle(style) : nullptr;
+  }
+  sk_sp<SkTypeface> onMatchFamilyStyleCharacter(const char* name,
+                                                const SkFontStyle& style,
+                                                const char*[],
+                                                int,
+                                                SkUnichar ch) const override {
+    auto preferred = onMatchFamilyStyle(name, style);
+    if (preferred && preferred->unicharToGlyph(ch)) {
+      return preferred;
+    }
+    for (int i = 0; i < onCountFamilies(); ++i) {
+      ComPtr<IDWriteFontFamily> family;
+      ComPtr<IDWriteFont> font;
+      BOOL supported = false;
+      auto slant = style.slant() == SkFontStyle::kItalic_Slant
+                       ? DWRITE_FONT_STYLE_ITALIC
+                   : style.slant() == SkFontStyle::kOblique_Slant
+                       ? DWRITE_FONT_STYLE_OBLIQUE
+                       : DWRITE_FONT_STYLE_NORMAL;
+      if (SUCCEEDED(collection_->GetFontFamily(i, &family)) &&
+          SUCCEEDED(family->GetFirstMatchingFont(
+              static_cast<DWRITE_FONT_WEIGHT>(style.weight()),
+              static_cast<DWRITE_FONT_STRETCH>(style.width()), slant, &font)) &&
+          SUCCEEDED(font->HasCharacter(ch, &supported)) && supported) {
+        auto face = Open(font.Get(), decoder_.get());
+        if (face && face->unicharToGlyph(ch)) {
+          return face;
+        }
+      }
+    }
+    return nullptr;
+  }
+  sk_sp<SkTypeface> onMakeFromData(sk_sp<SkData> data,
+                                   int index) const override {
+    return decoder_->makeFromData(std::move(data), index);
+  }
+  sk_sp<SkTypeface> onMakeFromStreamIndex(std::unique_ptr<SkStreamAsset> data,
+                                          int index) const override {
+    return decoder_->makeFromStream(std::move(data), index);
+  }
+  sk_sp<SkTypeface> onMakeFromStreamArgs(
+      std::unique_ptr<SkStreamAsset> data,
+      const SkFontArguments& args) const override {
+    return decoder_->makeFromStream(std::move(data), args);
+  }
+  sk_sp<SkTypeface> onMakeFromFile(const char* path, int index) const override {
+    return decoder_->makeFromFile(path, index);
+  }
+  sk_sp<SkTypeface> onLegacyMakeTypeface(const char* name,
+                                         SkFontStyle style) const override {
+    auto face = onMatchFamilyStyle(name, style);
+    return !face && name ? onMatchFamilyStyle(nullptr, style) : face;
+  }
+  ComPtr<IDWriteFontCollection> collection_;
+  sk_sp<SkFontMgr> decoder_;
+};
+}  // namespace
+
+sk_sp<SkFontMgr> CreatePhoneFontManager(IDWriteFactory* factory) {
+  ComPtr<IDWriteFontCollection> collection;
+  if (FAILED(factory->GetSystemFontCollection(&collection)) ||
+      !collection->GetFontFamilyCount()) {
+    return nullptr;
+  }
+  return sk_make_sp<Manager>(std::move(collection));
+}
+}  // namespace gfx::win
