diff --git a/content/shell/app/shell_main_winuwp.cc b/content/shell/app/shell_main_winuwp.cc
new file mode 100644
index 0000000..810fa3c
--- /dev/null
+++ b/content/shell/app/shell_main_winuwp.cc
@@ -0,0 +1,167 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// SDK 8.1's COM declarations reference IUnknown before declaring it. Load
+// Chromium's Windows types first so the SDK supplies the final WinNT macros.
+struct IUnknown;
+#include "base/win/windows_types.h"
+
+#include <windows.applicationmodel.core.h>
+#include <windows.ui.core.h>
+#include <wrl/client.h>
+#include <wrl/event.h>
+#include <wrl/implements.h>
+#include <wrl/wrappers/corewrappers.h>
+
+#include <atomic>
+#include <utility>
+
+#include "base/command_line.h"
+#include "content/public/app/content_main.h"
+#include "content/public/common/content_switches.h"
+#include "content/shell/app/shell_main_delegate.h"
+#include "content/shell/browser/shell.h"
+#include "sandbox/win/src/sandbox_types.h"
+
+namespace {
+namespace app = ABI::Windows::ApplicationModel::Core;
+namespace core = ABI::Windows::UI::Core;
+using Microsoft::WRL::Callback;
+using Microsoft::WRL::ComPtr;
+using Microsoft::WRL::Make;
+using Microsoft::WRL::RuntimeClass;
+using Microsoft::WRL::Wrappers::HStringReference;
+
+class ShellView final : public RuntimeClass<app::IFrameworkView> {
+ public:
+  explicit ShellView(HINSTANCE instance) : instance_(instance) {}
+
+  HRESULT STDMETHODCALLTYPE
+  Initialize(app::ICoreApplicationView* view) override {
+    using ActivationHandler = ABI::Windows::Foundation::ITypedEventHandler<
+        app::CoreApplicationView*,
+        ABI::Windows::ApplicationModel::Activation::IActivatedEventArgs*>;
+    auto activated = Callback<ActivationHandler>(
+        [](app::ICoreApplicationView* sender,
+           ABI::Windows::ApplicationModel::Activation::IActivatedEventArgs*) {
+          ComPtr<core::ICoreWindow> window;
+          HRESULT hr = sender->get_CoreWindow(&window);
+          return FAILED(hr) ? hr : window->Activate();
+        });
+    if (!activated) {
+      return E_OUTOFMEMORY;
+    }
+    HRESULT hr = view->add_Activated(activated.Get(), &activated_token_);
+    if (SUCCEEDED(hr)) {
+      view_ = view;
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE SetWindow(core::ICoreWindow* window) override {
+    using ClosedHandler = ABI::Windows::Foundation::ITypedEventHandler<
+        core::CoreWindow*, core::CoreWindowEventArgs*>;
+    auto closed = Callback<ClosedHandler>(
+        [](core::ICoreWindow*, core::ICoreWindowEventArgs*) {
+          content::Shell::Shutdown();
+          return S_OK;
+        });
+    if (!closed) {
+      return E_OUTOFMEMORY;
+    }
+    HRESULT hr = window->add_Closed(closed.Get(), &closed_token_);
+    if (SUCCEEDED(hr)) {
+      window_ = window;
+    }
+    return hr;
+  }
+
+  HRESULT STDMETHODCALLTYPE Load(HSTRING) override { return S_OK; }
+
+  HRESULT STDMETHODCALLTYPE Run() override {
+    if (!window_) {
+      return E_UNEXPECTED;
+    }
+    base::CommandLine::Init(0, nullptr);
+    auto* command_line = base::CommandLine::ForCurrentProcess();
+    if (command_line->HasSwitch(switches::kProcessType)) {
+      return E_INVALIDARG;
+    }
+    command_line->AppendSwitch(switches::kSingleProcess);
+    command_line->AppendSwitch("disable-gpu");
+    // Use the CPU compositor directly instead of probing WARP/SwiftShader.
+    // The shell presenter keeps its own D3D11 device for the CoreWindow.
+    command_line->AppendSwitch(switches::kDisableSoftwareRasterizer);
+    // This AppContainer hosts the browser and all content threads. There are
+    // no child processes for Chromium's desktop sandbox broker to launch.
+    sandbox::SandboxInterfaceInfo sandbox_info{};
+    content::ShellMainDelegate delegate;
+    content::ContentMainParams params(&delegate);
+    params.instance = instance_;
+    params.sandbox_info = &sandbox_info;
+    return content::ContentMain(std::move(params)) == 0 ? S_OK : E_FAIL;
+  }
+
+  HRESULT STDMETHODCALLTYPE Uninitialize() override {
+    if (window_) {
+      window_->remove_Closed(closed_token_);
+      window_.Reset();
+    }
+    if (view_) {
+      view_->remove_Activated(activated_token_);
+      view_.Reset();
+    }
+    return S_OK;
+  }
+
+ private:
+  HINSTANCE instance_;
+  ComPtr<app::ICoreApplicationView> view_;
+  ComPtr<core::ICoreWindow> window_;
+  EventRegistrationToken activated_token_{};
+  EventRegistrationToken closed_token_{};
+};
+
+class ShellViewSource final : public RuntimeClass<app::IFrameworkViewSource> {
+ public:
+  explicit ShellViewSource(HINSTANCE instance) : instance_(instance) {}
+
+  HRESULT STDMETHODCALLTYPE CreateView(app::IFrameworkView** result) override {
+    if (!result) {
+      return E_POINTER;
+    }
+    *result = nullptr;
+    if (created_.exchange(true)) {
+      return E_NOTIMPL;  // ContentMain owns the single browser view.
+    }
+    auto view = Make<ShellView>(instance_);
+    if (!view) {
+      return E_OUTOFMEMORY;
+    }
+    return view.CopyTo(result);
+  }
+
+ private:
+  HINSTANCE instance_;
+  std::atomic_bool created_{false};
+};
+}  // namespace
+
+int APIENTRY wWinMain(HINSTANCE instance, HINSTANCE, wchar_t*, int) {
+  Microsoft::WRL::Wrappers::RoInitializeWrapper runtime(RO_INIT_MULTITHREADED);
+  if (FAILED(runtime)) {
+    return static_cast<HRESULT>(runtime);
+  }
+  ComPtr<app::ICoreApplication> application;
+  HRESULT hr = ::RoGetActivationFactory(
+      HStringReference(
+          RuntimeClass_Windows_ApplicationModel_Core_CoreApplication)
+          .Get(),
+      IID_PPV_ARGS(&application));
+  if (FAILED(hr)) {
+    return hr;
+  }
+  auto source = Make<ShellViewSource>(instance);
+  return source ? application->Run(source.Get()) : E_OUTOFMEMORY;
+}
diff --git a/content/shell/browser/shell_phone_navigation.cc b/content/shell/browser/shell_phone_navigation.cc
new file mode 100644
index 0000000..f27b86c
--- /dev/null
+++ b/content/shell/browser/shell_phone_navigation.cc
@@ -0,0 +1,207 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "content/shell/browser/shell_phone_navigation.h"
+
+#include <algorithm>
+#include <array>
+
+#include "base/strings/string_util.h"
+#include "skia/ext/font_utils.h"
+#include "third_party/skia/include/core/SkPaint.h"
+
+namespace content {
+namespace {
+constexpr int kButtonWidth = 48;
+constexpr size_t kMaxAddress = 4096;
+
+void Label(SkCanvas& canvas,
+           const SkFont& font,
+           const SkRect& rect,
+           std::string_view text,
+           SkColor bg,
+           bool center,
+           bool tail = false) {
+  SkPaint paint;
+  paint.setColor(bg);
+  canvas.drawRect(rect, paint);
+  canvas.save();
+  SkRect inner = rect.makeInset(4, 1);
+  canvas.clipRect(inner);
+  paint.setColor(SK_ColorWHITE);
+  paint.setAntiAlias(true);
+  float length =
+      font.measureText(text.data(), text.size(), SkTextEncoding::kUTF8);
+  float x = center ? rect.centerX() - length / 2 : inner.left();
+  if (tail && length > inner.width()) {
+    x = inner.right() - length;
+  }
+  canvas.drawSimpleText(text.data(), text.size(), SkTextEncoding::kUTF8, x,
+                        rect.centerY() + font.getSize() * 0.35f, font, paint);
+  canvas.restore();
+}
+}  // namespace
+
+PhoneNavigation::PhoneNavigation() : font_(skia::DefaultTypeface(), 15) {}
+
+void PhoneNavigation::SetLocation(const GURL& location) {
+  GURL::Replacements redactions;
+  redactions.ClearUsername();
+  redactions.ClearPassword();
+  location_ = location.ReplaceComponents(redactions);
+}
+
+std::vector<PhoneNavigation::Key> PhoneNavigation::Keys(int width,
+                                                        int height) const {
+  const std::array<std::string_view, 4> rows =
+      symbols_ ? std::array<std::string_view, 4>{"1234567890", ":/?#[]@!$&",
+                                                 "'()*+,;=%~", "-._^|{}<>"}
+               : std::array<std::string_view, 4>{"1234567890", "qwertyuiop",
+                                                 "asdfghjkl", "zxcvbnm.-/"};
+  const int row_height = std::min(46, std::max(1, (height - kHeight) / 5));
+  int y = height - 5 * row_height;
+  std::vector<Key> keys;
+  auto add = [&](std::string label, size_t i, size_t count) {
+    keys.push_back({SkRect::MakeLTRB(width * i / count, y,
+                                     width * (i + 1) / count, y + row_height),
+                    std::move(label)});
+  };
+  for (auto row : rows) {
+    for (size_t i = 0; i < row.size(); ++i) {
+      char c = shift_ ? base::ToUpperASCII(row[i]) : row[i];
+      add(std::string(1, c), i, row.size());
+    }
+    y += row_height;
+  }
+  const std::array<std::string_view, 5> controls = {
+      symbols_ ? "ABC" : "#+=", "Shift", "Del", "Clear", "Go"};
+  for (size_t i = 0; i < controls.size(); ++i) {
+    add(std::string(controls[i]), i, controls.size());
+  }
+  return keys;
+}
+
+PhoneNavigation::Result PhoneNavigation::Submit() {
+  std::string address(base::TrimWhitespaceASCII(text_, base::TRIM_ALL));
+  GURL target(address);
+  // A host with an explicit port can initially parse as a custom URL scheme.
+  if (address.find("://") == std::string::npos) {
+    target = GURL("https://" + address);
+  }
+  if (!target.SchemeIsHTTPOrHTTPS() || !target.is_valid() ||
+      !target.has_host()) {
+    invalid_ = true;
+    return {};
+  }
+  editing_ = false;
+  return {Action::kNavigate, std::move(target)};
+}
+
+PhoneNavigation::Result PhoneNavigation::Apply(std::string_view key) {
+  invalid_ = false;
+  if (key == "Go") {
+    return Submit();
+  }
+  if (key == "Shift") {
+    shift_ = !shift_;
+  } else if (key == "ABC" || key == "#+=") {
+    symbols_ = !symbols_;
+  } else if (key == "Clear") {
+    text_.clear();
+    replace_on_type_ = false;
+  } else if (key == "Del") {
+    if (replace_on_type_) {
+      text_.clear();
+    } else if (!text_.empty()) {
+      text_.pop_back();
+    }
+    replace_on_type_ = false;
+  } else {
+    if (replace_on_type_) {
+      text_.clear();
+    }
+    replace_on_type_ = false;
+    if (text_.size() + key.size() <= kMaxAddress) {
+      text_.append(key);
+    }
+  }
+  return {};
+}
+
+PhoneNavigation::Result PhoneNavigation::Tap(int x,
+                                             int y,
+                                             int width,
+                                             int height) {
+  if (y < kHeight) {
+    if (x < kButtonWidth) {
+      if (!editing_) {
+        return {Action::kBack, {}};
+      }
+      editing_ = false;
+    } else if (x >= width - kButtonWidth) {
+      if (editing_) {
+        return Submit();
+      }
+      return {Action::kReload, {}};
+    } else if (!editing_) {
+      text_ = location_.SchemeIsHTTPOrHTTPS() ? location_.spec() : "";
+      editing_ = replace_on_type_ = true;
+      shift_ = symbols_ = invalid_ = false;
+    }
+  } else if (editing_) {
+    for (auto& key : Keys(width, height)) {
+      if (key.rect.contains(x, y)) {
+        return Apply(key.label);
+      }
+    }
+  }
+  return {};
+}
+
+PhoneNavigation::Result PhoneNavigation::Character(unsigned character) {
+  if (!editing_) {
+    return {};
+  }
+  if (character == 13) {
+    return Submit();
+  }
+  if (character == 8) {
+    return Apply("Del");
+  }
+  if (character == 27) {
+    editing_ = false;
+    return {};
+  }
+  if (character >= 32 && character <= 126) {
+    return Apply(std::string(1, static_cast<char>(character)));
+  }
+  return {};
+}
+
+void PhoneNavigation::Draw(SkCanvas& canvas, int width, int height) const {
+  constexpr SkColor bar = 0xff203241, field = 0xff344957, button = 0xff155b85;
+  Label(canvas, font_, SkRect::MakeXYWH(0, 0, kButtonWidth, kHeight),
+        editing_ ? "Cancel" : "Back", bar, true);
+  std::string_view address = editing_ ? text_ : location_.spec();
+  if (address.empty()) {
+    address = "Enter URL";
+  }
+  Label(canvas, font_,
+        SkRect::MakeLTRB(kButtonWidth, 0, width - kButtonWidth, kHeight),
+        address,
+        invalid_                       ? 0xff8c302e
+        : replace_on_type_ && editing_ ? button
+                                       : field,
+        false, editing_ && !replace_on_type_);
+  Label(canvas, font_,
+        SkRect::MakeLTRB(width - kButtonWidth, 0, width, kHeight),
+        editing_ ? "Go" : "Reload", bar, true);
+  if (editing_) {
+    for (auto& key : Keys(width, height)) {
+      Label(canvas, font_, key.rect.makeInset(0.5f, 0.5f), key.label,
+            key.label == "Go" ? button : bar, true);
+    }
+  }
+}
+}  // namespace content
