+    : file_(std::move(file)), task_runner_(std::move(task_runner)) {}
+
+FileStream::Context::~Context() = default;
+
+void FileStream::Context::OnFileOpened() {
+  // Each operation has its own event. No completion port registration is needed.
+  file_offset_ = 0;
+}
+
+int FileStream::Context::Read(IOBuffer* buf, int buf_len,
+                              CompletionOnceCallback callback) {
+  return PostFileOperation(Operation::kRead, buf, buf_len, std::move(callback));
+}
+
+int FileStream::Context::Write(IOBuffer* buf, int buf_len,
+                               CompletionOnceCallback callback) {
+  return PostFileOperation(Operation::kWrite, buf, buf_len, std::move(callback));
+}
+
+int FileStream::Context::PostFileOperation(Operation operation, IOBuffer* buf,
+                                           int buf_len,
+                                           CompletionOnceCallback callback) {
+  DCHECK(!async_in_progress_);
+  if (!task_runner_->PostTaskAndReplyWithResult(
+          FROM_HERE, base::BindOnce(&Context::RunFileOperation,
+                                    base::Unretained(this), operation,
+                                    base::WrapRefCounted(buf), buf_len),
+          base::BindOnce(&Context::OnAsyncCompleted, base::Unretained(this),
+                         std::move(callback)))) {
+    return ERR_FAILED;
+  }
+  async_in_progress_ = true;
+  return ERR_IO_PENDING;
+}
+
+FileStream::Context::IOResult FileStream::Context::RunFileOperation(
+    Operation operation, scoped_refptr<IOBuffer> buf, int buf_len) {
+  // Phone lacks file completion ports and CancelIo. Retain the context and
+  // buffer until this worker has observed the terminal result, even if orphaned.
+  base::win::ScopedHandle event(
+      ::CreateEventExW(nullptr, nullptr, CREATE_EVENT_MANUAL_RESET,
+                       EVENT_MODIFY_STATE | SYNCHRONIZE));
+  if (!event.is_valid()) {
+    return IOResult::FromOSError(::GetLastError());
+  }
+  OVERLAPPED overlapped = {};
+  overlapped.Offset = static_cast<DWORD>(file_offset_);
+  overlapped.OffsetHigh = static_cast<DWORD>(file_offset_ >> 32);
+  overlapped.hEvent = event.get();
+  DWORD bytes = 0;
+  const HANDLE file = file_.GetPlatformFile();
+  const bool read = operation == Operation::kRead;
+  BOOL ok = read ? ::ReadFile(file, buf->data(), buf_len, &bytes, &overlapped)
+                 : ::WriteFile(file, buf->data(), buf_len, &bytes, &overlapped);
+  if (!ok && ::GetLastError() == ERROR_IO_PENDING) {
+    ok = ::GetOverlappedResultEx(file, &overlapped, &bytes, INFINITE, FALSE);
+  }
+  if (!ok) {
+    const DWORD error = ::GetLastError();
+    if (read && error == ERROR_HANDLE_EOF) {
+      return IOResult(0, 0);
+    }
+    return IOResult::FromOSError(error);
+  }
+  file_offset_ = base::CheckAdd(file_offset_, bytes).ValueOrDie();
+  return IOResult(bytes, 0);
+}
+
