+import json
+import os
+from pathlib import Path
+import shlex
+import sys
+
+
+def main():
+    binary, tool_config, target_config, output, source = map(Path, sys.argv[1:])
+    if json.loads(tool_config.read_text()) != json.loads(target_config.read_text()):
+        raise ValueError(f"V8 Phone configuration mismatch: {tool_config} and {target_config}")
+    with binary.open("rb") as handle:
+        header = handle.read(20)
+    if header[:6] != b"\x7fELF\x01\x01" or header[18:20] != b"\x03\x00":
+        raise ValueError(f"Expected an IA32 ELF host executable: {binary}")
+
+    source = source.resolve()
+    executable = binary.resolve().relative_to(source)
+    # Preserve source-relative paths passed by Ninja. Only its output directory
+    # needs write access, including Torque's and mksnapshot's generated files.
+    launcher = shlex.join([
+        "docker", "run", "--rm", "--network", "none", "--platform", "linux/amd64",
+        "--volume", f"{source}:{source}:ro", "--volume",
+        f"{Path.cwd()}:{Path.cwd()}:rw", "--workdir", str(Path.cwd()),
+        "wp81-v8-host:bookworm", str(source / executable),
+    ])
+    output.write_text(f'#!/bin/sh\nexec {launcher} "$@"\n')
+    os.chmod(output, 0o755)
+
+
+if __name__ == "__main__":
+    main()
