@@ -0,0 +1,53 @@
+#ifndef THIRD_PARTY_SQLITE_PHONE81_VFS_H_
+#define THIRD_PARTY_SQLITE_PHONE81_VFS_H_
+
+#include <windows.h>
+
+#define SQLITE_PHONE81 1
+#define SQLITE_UWP 1
+#define SQLITE_DISABLE_INTRINSIC 1
+#define SQLITE_MEMORY_BARRIER __atomic_thread_fence(__ATOMIC_SEQ_CST)
+#undef SQLITE_MAX_MMAP_SIZE
+#define SQLITE_MAX_MMAP_SIZE 0
+
+// The desktop attribute and flag fields share a parameter. CreateFile2
+// takes them separately, including DELETE_ON_CLOSE for SQLite temp files.
+static HANDLE WINAPI phoneCreateFile(LPCWSTR path, DWORD access, DWORD share,
+    LPSECURITY_ATTRIBUTES security, DWORD disposition, DWORD flags, HANDLE tmpl) {
+  CREATEFILE2_EXTENDED_PARAMETERS params = {0};
+  params.dwSize = sizeof(params);
+  params.dwFileAttributes = flags & 0xffff;
+  params.dwFileFlags = flags & 0xfff00000;
+  params.lpSecurityAttributes = security;
+  params.hTemplateFile = tmpl;
+  return CreateFile2(path, access, share, disposition, &params);
+}
+static DWORD WINAPI phoneAttributes(LPCWSTR path) {
+  WIN32_FILE_ATTRIBUTE_DATA info;
+  return GetFileAttributesExW(path, GetFileExInfoStandard, &info)
+      ? info.dwFileAttributes : INVALID_FILE_ATTRIBUTES;
+}
+static BOOL WINAPI phoneSize(HANDLE file, PLARGE_INTEGER size) {
+  FILE_STANDARD_INFO info;
+  if (!GetFileInformationByHandleEx(file, FileStandardInfo, &info, sizeof(info)))
+    return FALSE;
+  *size = info.EndOfFile;
+  return TRUE;
+}
+static BOOL WINAPI phoneAnsi(void) { return TRUE; }
+static DWORD WINAPI phoneWait(HANDLE object, DWORD timeout) {
+  return WaitForSingleObjectEx(object, timeout, FALSE);
+}
+DWORD WINAPI sqlitePhoneFullPath(LPCWSTR, DWORD, LPWSTR, LPWSTR*);
+DWORD WINAPI sqlitePhoneTempPath(DWORD, LPWSTR);
+#define GetFullPathNameW sqlitePhoneFullPath
+#define GetTempPathW sqlitePhoneTempPath
+#define AreFileApisANSI phoneAnsi
+#define GetSystemInfo GetNativeSystemInfo
+#define CreateFileW phoneCreateFile
+#define GetFileSizeEx phoneSize
+#define GetFileAttributesW phoneAttributes
+#define WaitForSingleObject phoneWait
+#define InitializeCriticalSection(cs) InitializeCriticalSectionEx(cs, 0, 0)
+
+#endif
