+#include "ui/display/screen_base.h"
+#include "ui/events/event.h"
+#include "ui/events/event_utils.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+
+namespace content {
+namespace {
+namespace core = ABI::Windows::UI::Core;
+namespace foundation = ABI::Windows::Foundation;
+using Microsoft::WRL::ComPtr;
+// WindowTreeHost queries the display during its base constructor and
+// destructor.
+class PhoneScreen {
+ protected:
+  PhoneScreen() {
+    CHECK(!display::Screen::HasScreen());
+    display::Screen::SetScreenInstance(&screen_);
+  }
+  ~PhoneScreen() { display::Screen::SetScreenInstance(nullptr); }
+  display::ScreenBase screen_;
+};
+
+class PhoneWindow final : private PhoneScreen, public aura::WindowTreeHost {
+ public:
+  PhoneWindow() {
+    ComPtr<core::ICoreWindowStatic> factory;
+    CHECK(SUCCEEDED(
+        RoGetActivationFactory(Microsoft::WRL::Wrappers::HStringReference(
+                                   RuntimeClass_Windows_UI_Core_CoreWindow)
+                                   .Get(),
+                               IID_PPV_ARGS(&factory))));
+    CHECK(SUCCEEDED(factory->GetForCurrentThread(&window_)) && window_);
+    UpdateBounds();
+    SetNativeWindowOcclusionEnabled(false);
+    CreateCompositor(false);
+    OnAcceleratedWidgetAvailable();
+    touch_ = std::make_unique<PhoneTouchInput>(
+        window_.Get(),
+        base::BindRepeating(&PhoneWindow::OnTouch, base::Unretained(this)),
+        base::BindRepeating(&PhoneWindow::OnCharacter, base::Unretained(this)));
+  }
+
+  ~PhoneWindow() override {
+    timer_.Stop();
+    touch_.reset();
+    DestroyCompositor();
+    DestroyDispatcher();
+  }
+
+  void ShowContents(WebContents* contents) {
+    contents_ = contents->GetWeakPtr();
+    page_.reset();
+    contents->GetNativeView()->SetBounds(PageBounds());
+    navigation_.SetLocation(contents->GetVisibleURL());
+    Draw();
+    contents->Focus();
+    contents->WasShown();
+    timer_.Start(FROM_HERE, base::Milliseconds(33), this, &PhoneWindow::Tick);
+  }
+
+  void SetLocation(WebContents* contents, const GURL& url) {
+    if (contents_.get() == contents) {
+      navigation_.SetLocation(url);
+      Draw();
+    }
+  }
+
+ private:
+  gfx::Rect PageBounds() const {
+    return gfx::Rect(0, PhoneNavigation::kHeight, bounds_.width(),
+                     std::max(0, bounds_.height() - PhoneNavigation::kHeight));
+  }
+
+  void Navigate(PhoneNavigation::Result result) {
+    Draw();
+    auto* shell = contents_ ? Shell::FromWebContents(contents_.get()) : nullptr;
+    if (!shell) {
+      return;
+    }
+    switch (result.action) {
+      case PhoneNavigation::Action::kBack:
+        shell->GoBackOrForward(-1);
+        break;
+      case PhoneNavigation::Action::kReload:
+        shell->Reload();
+        break;
+      case PhoneNavigation::Action::kNavigate:
+        shell->LoadURL(result.url);
+        break;
+      case PhoneNavigation::Action::kNone:
+        break;
+    }
+  }
+
+  bool OnCharacter(unsigned character) {
+    if (!navigation_.editing()) {
+      return false;
+    }
+    Navigate(navigation_.Character(character));
+    return true;
+  }
+
+  void OnTouch(ui::EventType type, UINT32 id, float x, float y) {
+    gfx::PointF location(x, y);
+    if (type == ui::EventType::kTouchPressed && navigation_.OwnsPoint(y)) {
+      navigation_contacts_[id] = location;
+      return;
+    }
+    auto contact = navigation_contacts_.find(id);
+    if (contact != navigation_contacts_.end()) {
+      if (type == ui::EventType::kTouchReleased ||
+          type == ui::EventType::kTouchCancelled) {
+        bool tapped = type == ui::EventType::kTouchReleased &&
+                      (location - contact->second).LengthSquared() < 64;
+        navigation_contacts_.erase(contact);
+        if (tapped) {
+          Navigate(navigation_.Tap(x, y, bounds_.width(), bounds_.height()));
+        }
+      }
+      return;
+    }
+    ui::TouchEvent event(type, location, location, ui::EventTimeForNow(),
+                         ui::PointerDetails(ui::EventPointerType::kTouch, id));
+    SendEventToSink(&event);
+  }
+
+  void UpdateBounds() {
+    foundation::Rect rect;
+    if (FAILED(window_->get_Bounds(&rect)) || rect.Width <= 0 ||
+        rect.Height <= 0) {
+      return;
+    }
+    gfx::Rect next(static_cast<int>(rect.Width), static_cast<int>(rect.Height));
+    if (next == bounds_) {
+      return;
+    }
+    screen_.display_list().AddOrUpdateDisplay(
+        display::Display(1, next), display::DisplayList::Type::PRIMARY);
+    SetBoundsInPixels(next);
+    if (contents_) {
+      contents_->GetNativeView()->SetBounds(PageBounds());
+      page_.reset();
+      Draw();
+    }
+  }
+
+  void Tick() {
+    UpdateBounds();
+    if (!contents_ || pending_ || bounds_.IsEmpty()) {
+      return;
+    }
+    boolean visible = false;
+    if (FAILED(window_->get_Visible(&visible)) || !visible) {
+      return;
+    }
+    auto* view = contents_->GetRenderWidgetHostView();
+    if (!view) {
+      return;
+    }
+    pending_ = true;
+    view->CopyFromSurface(
+        {}, PageBounds().size(), base::Milliseconds(250),
+        base::BindPostTaskToCurrentDefault(base::BindOnce(
+            &PhoneWindow::OnFrame, weak_factory_.GetWeakPtr(), contents_)));
+  }
+
+  void OnFrame(base::WeakPtr<WebContents> source,
+               const CopyFromSurfaceResult& result) {
+    pending_ = false;
+    if (!source || source.get() != contents_.get() || !result.has_value()) {
+      return;
+    }
+    const SkBitmap& bitmap = result->bitmap;
+    if (bitmap.width() != PageBounds().width() ||
+        bitmap.height() != PageBounds().height() || !bitmap.getPixels()) {
+      return;
+    }
+    page_ = bitmap;
+    Draw();
+  }
+
+  void Draw() {
+    if (bounds_.IsEmpty()) {
+      return;
+    }
+    SkImageInfo info =
+        SkImageInfo::Make(bounds_.width(), bounds_.height(),
+                          kBGRA_8888_SkColorType, kPremul_SkAlphaType);
+    if (screen_image_.info() != info && !screen_image_.tryAllocPixels(info)) {
+      return;
+    }
+    SkCanvas canvas(screen_image_);
+    canvas.clear(SK_ColorWHITE);
+    if (!page_.drawsNothing()) {
+      canvas.writePixels(page_, 0, PhoneNavigation::kHeight);
+    }
+    navigation_.Draw(canvas, bounds_.width(), bounds_.height());
+    HRESULT hr =
+        presenter_.Submit(window_.Get(), bounds_.width(), bounds_.height(),
+                          screen_image_.getPixels(), screen_image_.rowBytes());
+    if (FAILED(hr) && hr != last_present_error_) {
+      LOG(ERROR) << "CoreWindow frame presentation failed, HRESULT " << std::hex
+                 << hr;
+    }
+    last_present_error_ = hr;
+  }
+
+  ui::EventSource* GetEventSource() override { return this; }
+  gfx::AcceleratedWidget GetAcceleratedWidget() override { return {}; }
+  gfx::Rect GetBoundsInPixels() const override { return bounds_; }
+  void SetBoundsInPixels(const gfx::Rect& bounds) override {
+    bounds_ = bounds;
+    if (compositor()) {
+      OnHostResizedInPixels(bounds.size());
+    }
+  }
+  gfx::Point GetLocationOnScreenInPixels() const override { return {}; }
+  void ShowImpl() override {}
+  void HideImpl() override {}
+  void SetCapture() override { window_->SetPointerCapture(); }
+  void ReleaseCapture() override { window_->ReleasePointerCapture(); }
+  bool CaptureSystemKeyEventsImpl(
+      std::optional<base::flat_set<ui::DomCode>>) override {
+    return false;
+  }
+  void ReleaseSystemKeyEventCapture() override {}
+  bool IsKeyLocked(ui::DomCode) override { return false; }
+  base::flat_map<std::string, std::string> GetKeyboardLayoutMap() override {
+    return {};
+  }
+  void SetCursorNative(gfx::NativeCursor) override {}
+  void MoveCursorToScreenLocationInPixels(const gfx::Point&) override {}
+  void OnCursorVisibilityChangedNative(bool) override {}
+
+  ComPtr<core::ICoreWindow> window_;
+  PhoneFramePresenter presenter_;
+  PhoneNavigation navigation_;
+  std::map<UINT32, gfx::PointF> navigation_contacts_;
+  SkBitmap screen_image_;
+  SkBitmap page_;
+  gfx::Rect bounds_;
+  base::WeakPtr<WebContents> contents_;
+  base::RepeatingTimer timer_;
+  std::unique_ptr<PhoneTouchInput> touch_;
+  HRESULT last_present_error_ = S_OK;
+  bool pending_ = false;
+  base::WeakPtrFactory<PhoneWindow> weak_factory_{this};
+};
+}  // namespace
+
+std::unique_ptr<aura::WindowTreeHost> CreatePhoneWindowTreeHost() {
+  return std::make_unique<PhoneWindow>();
+}
+
+void ShowPhoneWebContents(aura::WindowTreeHost* host, WebContents* contents) {
+  static_cast<PhoneWindow*>(host)->ShowContents(contents);
+}
+void SetPhoneLocation(aura::WindowTreeHost* host,
+                      WebContents* contents,
+                      const GURL& url) {
+  static_cast<PhoneWindow*>(host)->SetLocation(contents, url);
+}
+
+}  // namespace content
