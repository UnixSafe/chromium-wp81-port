+  size_t pos = 0;
+  while (pos < command_line.size()) {
+    while (pos < command_line.size() &&
+           (command_line[pos] == L' ' || command_line[pos] == L'\t')) {
+      ++pos;
+    }
+    if (pos == command_line.size()) {
+      break;
+    }
+    StringType arg;
+    bool quoted = false;
+    while (pos < command_line.size()) {
+      size_t slashes = 0;
+      while (pos < command_line.size() && command_line[pos] == L'\\') {
+        ++slashes;
+        ++pos;
+      }
+      if (pos < command_line.size() && command_line[pos] == L'"') {
+        arg.append(slashes / 2, L'\\');
+        if (slashes % 2) {
+          arg.push_back(L'"');
+        } else if (quoted && pos + 1 < command_line.size() &&
+                   command_line[pos + 1] == L'"') {
+          arg.push_back(L'"');
+          ++pos;
+        } else {
+          quoted = !quoted;
+        }
+        ++pos;
+        continue;
+      }
+      arg.append(slashes, L'\\');
+      if (pos == command_line.size() ||
+          (!quoted &&
+           (command_line[pos] == L' ' || command_line[pos] == L'\t'))) {
+        break;
+      }
+      arg.push_back(command_line[pos++]);
+    }
+    argv.push_back(std::move(arg));
+  }
+  InitFromArgv(argv);
+  raw_command_line_string_ = StringViewType();
