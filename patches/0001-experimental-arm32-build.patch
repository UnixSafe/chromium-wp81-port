+// found in the LICENSE file.
+
+#ifndef BASE_FILES_READ_ONLY_RESOURCE_FILE_H_
+#define BASE_FILES_READ_ONLY_RESOURCE_FILE_H_
+
+#include "base/files/memory_mapped_file.h"
+#include "base/win/windows_phone_8_1.h"
+
+#if BASE_WIN_IS_PHONE_8_1
+#include "base/containers/heap_array.h"
+#include "base/process/memory.h"
+#endif
+
+namespace base {
+
+#if BASE_WIN_IS_PHONE_8_1
+// Phone 8.1 cannot map file-backed sections. Only immutable resources such as
+// ICU data, V8 startup data and .pak files may use this private snapshot.
+class ReadOnlyResourceFile {
+ public:
+  static constexpr size_t kMaxResourceSize = 64 * 1024 * 1024;
+
+  bool Initialize(File file, MemoryMappedFile::Region region =
+                                 MemoryMappedFile::Region::kWholeFile) {
+    if (IsValid() || !file.IsValid() || file.async()) {
+      return false;
+    }
+    const int64_t length = file.GetLength();
+    if (length <= 0 || region.offset < 0 || region.offset > length) {
+      return false;
+    }
+    const uint64_t available = static_cast<uint64_t>(length - region.offset);
+    const uint64_t size =
+        region == MemoryMappedFile::Region::kWholeFile ? available : region.size;
+    if (!size || size > available || size > kMaxResourceSize) {
+      return false;
+    }
+    // ICU requires 16-byte aligned data. Keep the file handle alive as ICU
+    // can return it to callers after initialization.
+    void* allocation = nullptr;
+    const auto count = static_cast<size_t>(size);
+    if (!UncheckedAlignedAlloc(count, 16, &allocation)) {
+      return false;
+    }
+    // SAFETY: allocation has count bytes, and Storage frees it with the
+    // allocator's matching aligned deallocator.
+    auto data = UNSAFE_BUFFERS(Storage::FromOwningPointer(
+        static_cast<uint8_t*>(allocation), count));
+    if (!file.ReadAndCheck(region.offset, data.as_span())) {
+      return false;
+    }
+    file_ = std::move(file);
+    data_ = std::move(data);
+    return true;
+  }
+
+  bool IsValid() const { return !data_.empty(); }
+  span<const uint8_t> bytes() const { return data_.as_span(); }
+
+ private:
+  struct Deleter {
+    void operator()(void* data) const { UncheckedAlignedFree(data); }
+  };
+  using Storage = HeapArray<uint8_t, Deleter>;
+  File file_;
+  Storage data_;
+};
+#else
+using ReadOnlyResourceFile = MemoryMappedFile;
+#endif
