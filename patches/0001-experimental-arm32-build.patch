+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <windows.ui.viewmanagement.h>
+#include <wrl/client.h>
+
+#include <algorithm>
+#include <cmath>
+#include <optional>
+
+#include "base/check.h"
+#include "base/no_destructor.h"
+#include "base/numerics/safe_conversions.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/win/core_winrt_util.h"
+#include "base/win/hstring_reference.h"
+#include "ui/gfx/system_fonts_win.h"
+
+namespace gfx::win {
+namespace {
+AdjustFontCallback font_callback = nullptr;
+GetMinimumFontSizeCallback minimum_callback = nullptr;
+std::optional<Font>& CachedFont() {
+  static base::NoDestructor<std::optional<Font>> cached;
+  return *cached;
+}
+double TextScale() {
+  using Microsoft::WRL::ComPtr;
+  ComPtr<IInspectable> instance;
+  ComPtr<ABI::Windows::UI::ViewManagement::IUISettings2> settings;
+  double scale;
+  if (SUCCEEDED(base::win::RoActivateInstance(
+          base::win::HStringReference(
+              RuntimeClass_Windows_UI_ViewManagement_UISettings)
+              .Get(),
+          &instance)) &&
+      SUCCEEDED(instance.As(&settings)) &&
+      SUCCEEDED(settings->get_TextScaleFactor(&scale)) &&
+      std::isfinite(scale) && scale > 0) {
+    return scale;
+  }
+  return 1.;
+}
+}  // namespace
+int AdjustFontSize(int height, int delta) {
+  int adjusted = std::max(minimum_callback ? minimum_callback() : 0,
+                          std::abs(height) + delta);
+  return height < 0 ? -adjusted : adjusted;
+}
+void SetGetMinimumFontSizeCallback(GetMinimumFontSizeCallback callback) {
+  DCHECK(!CachedFont());
+  minimum_callback = callback;
+}
+void SetAdjustFontCallback(AdjustFontCallback callback) {
+  DCHECK(!CachedFont());
+  font_callback = callback;
+}
+const Font& GetDefaultSystemFont() {
+  auto& cached = CachedFont();
+  if (!cached) {
+    FontAdjustment adjustment;
+    adjustment.font_scale = TextScale();
+    if (font_callback) {
+      font_callback(adjustment);
+    }
+    int size = std::max(
+        1, AdjustFontSize(base::ClampRound(14. * adjustment.font_scale), 0));
+    cached.emplace(adjustment.font_family_override.empty()
+                       ? "Segoe WP"
+                       : base::WideToUTF8(adjustment.font_family_override),
+                   size);
+  }
+  return *cached;
+}
+const Font& GetSystemFont(SystemFont) {
+  // Phone has one shell UI family and no NONCLIENTMETRICS roles.
+  return GetDefaultSystemFont();
+}
+void ResetSystemFontsForTesting() {
+  CachedFont().reset();
+  minimum_callback = nullptr;
+  font_callback = nullptr;
+}
+}  // namespace gfx::win
