diff --git a/third_party/sqlite/phone81_paths.cc b/third_party/sqlite/phone81_paths.cc
new file mode 100644
index 0000000..799be4f
--- /dev/null
+++ b/third_party/sqlite/phone81_paths.cc
@@ -0,0 +1,118 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <windows.h>
+
+#if defined(WINUWP_8_1) && WINAPI_FAMILY == WINAPI_FAMILY_PHONE_APP
+#include <roapi.h>
+#include <windows.storage.h>
+#include <wrl/client.h>
+#include <wrl/wrappers/corewrappers.h>
+
+#include <algorithm>
+#include <string>
+
+namespace {
+using namespace ABI::Windows::Storage;
+using Microsoft::WRL::ComPtr;
+using Microsoft::WRL::Wrappers::HString;
+using Microsoft::WRL::Wrappers::HStringReference;
+
+HRESULT AppFolder(bool temporary, std::wstring& path) {
+  ComPtr<IApplicationDataStatics> factory;
+  HRESULT hr = RoGetActivationFactory(
+      HStringReference(RuntimeClass_Windows_Storage_ApplicationData).Get(),
+      IID_PPV_ARGS(&factory));
+  ComPtr<IApplicationData> data;
+  if (SUCCEEDED(hr)) hr = factory->get_Current(&data);
+  ComPtr<IStorageFolder> folder;
+  if (SUCCEEDED(hr)) {
+    hr = temporary ? data->get_TemporaryFolder(&folder)
+                   : data->get_LocalFolder(&folder);
+  }
+  ComPtr<IStorageItem> item;
+  if (SUCCEEDED(hr)) hr = folder.As(&item);
+  HString value;
+  if (SUCCEEDED(hr)) hr = item->get_Path(value.GetAddressOf());
+  if (SUCCEEDED(hr)) {
+    UINT32 length;
+    const wchar_t* raw = WindowsGetStringRawBuffer(value.Get(), &length);
+    if (!length) return E_FAIL;
+    path.assign(raw, length);
+  }
+  return hr;
+}
+
+bool GetFolder(bool temporary, std::wstring& path) {
+  HRESULT init = RoInitialize(RO_INIT_MULTITHREADED);
+  HRESULT hr = init;
+  if (SUCCEEDED(init) || init == RPC_E_CHANGED_MODE) hr = AppFolder(temporary, path);
+  if (SUCCEEDED(init)) RoUninitialize();
+  if (FAILED(hr)) SetLastError(HRESULT_FACILITY(hr) == FACILITY_WIN32
+                                   ? HRESULT_CODE(hr) : ERROR_PATH_NOT_FOUND);
+  return SUCCEEDED(hr);
+}
+
+DWORD CopyPath(const std::wstring& path, DWORD capacity, LPWSTR output) {
+  if (path.size() >= MAXDWORD) {
+    SetLastError(ERROR_FILENAME_EXCED_RANGE);
+    return 0;
+  }
+  DWORD length = static_cast<DWORD>(path.size());
+  if (length >= capacity || !output) return length + 1;
+  std::copy_n(path.c_str(), length + 1, output);
+  return length;
+}
+}  // namespace
+
+extern "C" DWORD WINAPI sqlitePhoneTempPath(DWORD capacity, LPWSTR output) {
+  std::wstring path;
+  if (!GetFolder(true, path)) return 0;
+  path.push_back(L'\\');
+  if (path.size() >= capacity) {
+    SetLastError(ERROR_INSUFFICIENT_BUFFER);
+    return 0;
+  }
+  return CopyPath(path, capacity, output);
+}
+
+extern "C" DWORD WINAPI sqlitePhoneFullPath(LPCWSTR input, DWORD capacity,
+                                           LPWSTR output, LPWSTR* file_part) {
+  std::wstring path(input);
+  std::replace(path.begin(), path.end(), L'/', L'\\');
+  if (path.empty() || path.front() == L'\\' ||
+      (path.size() > 1 && path[1] == L':' &&
+       (path.size() < 3 || path[2] != L'\\'))) {
+    SetLastError(ERROR_BAD_PATHNAME);
+    return 0;
+  }
+  if (path.size() < 2 || path[1] != L':') {
+    std::wstring local;
+    if (!GetFolder(false, local)) return 0;
+    path = local + L"\\" + path;
+  }
+  if (path.size() < 3 || path[1] != L':' || path[2] != L'\\') {
+    SetLastError(ERROR_BAD_PATHNAME);
+    return 0;
+  }
+  std::wstring normalized = path.substr(0, 3);
+  for (size_t pos = 3; pos < path.size();) {
+    size_t end = path.find(L'\\', pos);
+    std::wstring part = path.substr(pos, end - pos);
+    if (part == L"..") {
+      size_t slash = normalized.rfind(L'\\');
+      normalized.resize(std::max<size_t>(3, slash));
+    } else if (!part.empty() && part != L".") {
+      if (normalized.size() > 3) normalized.push_back(L'\\');
+      normalized += part;
+    }
+    if (end == std::wstring::npos) break;
+    pos = end + 1;
+  }
+  DWORD count = CopyPath(normalized, capacity, output);
+  if (output && count && count < capacity && file_part)
+    *file_part = output + normalized.rfind(L'\\') + 1;
+  return count;
+}
+#endif
