+using Microsoft::WRL::ComPtr;
+
+// Network helpers run on both application and worker threads. Reuse an
+// existing STA if one is present and balance only successful initializations.
+class NetworkApartment {
+ public:
+  NetworkApartment() : hr_(::RoInitialize(RO_INIT_MULTITHREADED)) {}
+  ~NetworkApartment() {
+    if (SUCCEEDED(hr_)) {
+      ::RoUninitialize();
+    }
+  }
+  bool ready() const { return SUCCEEDED(hr_) || hr_ == RPC_E_CHANGED_MODE; }
+
+ private:
+  const HRESULT hr_;
+};
+
+inline ComPtr<connectivity::INetworkInformationStatics> NetworkInformation() {
+  ComPtr<connectivity::INetworkInformationStatics> info;
+  base::win::GetActivationFactory<
+      connectivity::INetworkInformationStatics,
+      RuntimeClass_Windows_Networking_Connectivity_NetworkInformation>(
+      info.GetAddressOf());
+  return info;
+}
+
+inline NetworkChangeNotifier::ConnectionType AdapterType(
+    connectivity::INetworkAdapter* adapter) {
+  unsigned int iana = 0;
+  if (adapter && SUCCEEDED(adapter->get_IanaInterfaceType(&iana))) {
+    if (iana == 71) {
+      return NetworkChangeNotifier::CONNECTION_WIFI;
+    }
+    if (iana == 6) {
+      return NetworkChangeNotifier::CONNECTION_ETHERNET;
+    }
+  }
+  return NetworkChangeNotifier::CONNECTION_UNKNOWN;
+}
+}  // namespace net::phone
+#endif  // NET_BASE_NETWORK_INFORMATION_PHONE_H_
