+            __uuidof(ABI::Windows::ApplicationModel::IPackageStatics),
+            reinterpret_cast<void**>(statics.GetAddressOf())))) {
+      return false;
+    }
+    Microsoft::WRL::ComPtr<ABI::Windows::ApplicationModel::IPackage> package;
+    Microsoft::WRL::ComPtr<ABI::Windows::Storage::IStorageFolder> folder;
+    Microsoft::WRL::ComPtr<ABI::Windows::Storage::IStorageItem> item;
+    Microsoft::WRL::Wrappers::HString path;
+    if (FAILED(statics->get_Current(package.GetAddressOf())) ||
+        FAILED(package->get_InstalledLocation(folder.GetAddressOf())) ||
+        FAILED(folder.As(&item)) ||
+        FAILED(item->get_Path(path.GetAddressOf()))) {
+      return false;
+    }
+    UINT32 length = 0;
+    const wchar_t* raw = WindowsGetStringRawBuffer(path.Get(), &length);
+    std::wstring full_path(raw, length);
+    full_path += L"\\content_shell.exe";
+    *result = FilePath(full_path);
+    return true;
+#else
+    wchar_t buffer[MAX_PATH];
+    HMODULE module = key == FILE_MODULE ? CURRENT_MODULE() : nullptr;
+    DWORD length = GetModuleFileNameW(module, buffer, MAX_PATH);
+    if (length == 0 || length >= MAX_PATH) {
+      return false;
+    }
+    *result = FilePath(std::wstring(buffer, length));
+    return true;
+#endif
+  }
+
+  if (key != DIR_LOCAL_APP_DATA && key != DIR_ROAMING_APP_DATA &&
+      key != DIR_SYSTEM_TEMP) {
+    return false;
+  }
+
+  HRESULT init_result = RoInitialize(RO_INIT_MULTITHREADED);
+  if (FAILED(init_result) && init_result != RPC_E_CHANGED_MODE) {
+    return false;
+  }
+
+  bool found = [&] {
+    HSTRING class_name = nullptr;
+    HRESULT hr = WindowsCreateString(
+        RuntimeClass_Windows_Storage_ApplicationData,
+        static_cast<UINT32>(wcslen(RuntimeClass_Windows_Storage_ApplicationData)),
+        &class_name);
+    if (FAILED(hr)) {
+      return false;
+    }
