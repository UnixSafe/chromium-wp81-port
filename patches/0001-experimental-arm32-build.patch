diff --git a/third_party/libc++/src/src/support/runtime/exception_pointer_phone81.ipp b/third_party/libc++/src/src/support/runtime/exception_pointer_phone81.ipp
new file mode 100644
index 0000000..16df41f
--- /dev/null
+++ b/third_party/libc++/src/src/support/runtime/exception_pointer_phone81.ipp
@@ -0,0 +1,50 @@
+// -*- C++ -*-
+//===----------------------------------------------------------------------===//
+//
+// Part of the LLVM Project, under the Apache License v2.0 with LLVM Exceptions.
+// See https://llvm.org/LICENSE.txt for license information.
+// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
+//
+//===----------------------------------------------------------------------===//
+
+// exception_ptr for the Windows Phone 8.1 port of Chromium.
+//
+// LLVM cannot emit Windows C++ exception handling for ARM32, so that build
+// compiles libc++ and every other target without exceptions. No C++
+// exception can therefore be in flight or captured: every exception_ptr is
+// null, and rethrowing one terminates the process. exception_pointer_msvc.ipp
+// cannot be used here: it needs try/catch and vcruntime140 internals that the
+// VC120 Phone runtime does not have.
+
+#include <__verbose_abort>
+
+namespace std {
+
+exception_ptr::~exception_ptr() noexcept {}
+
+exception_ptr::exception_ptr(const exception_ptr& __other) noexcept : __ptr_(__other.__ptr_) {}
+
+exception_ptr& exception_ptr::operator=(const exception_ptr& __other) noexcept {
+  __ptr_ = __other.__ptr_;
+  return *this;
+}
+
+exception_ptr exception_ptr::__from_native_exception_pointer(void*) noexcept { return exception_ptr(); }
+
+exception_ptr __copy_exception_ptr(void*, const void*) { return exception_ptr(); }
+
+exception_ptr current_exception() noexcept { return exception_ptr(); }
+
+[[noreturn]] void rethrow_exception(exception_ptr) {
+  __libcpp_verbose_abort("rethrow_exception: C++ exceptions are disabled in the Windows Phone 8.1 build\n");
+}
+
+nested_exception::nested_exception() noexcept : __ptr_(current_exception()) {}
+
+nested_exception::~nested_exception() noexcept {}
+
+[[noreturn]] void nested_exception::rethrow_nested() const {
+  __libcpp_verbose_abort("rethrow_nested: C++ exceptions are disabled in the Windows Phone 8.1 build\n");
+}
+
+} // namespace std
