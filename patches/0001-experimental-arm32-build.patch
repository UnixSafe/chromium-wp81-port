+namespace networking = ABI::Windows::Networking;
+
+// WinRT associates IP addresses with a persistent adapter GUID. A numeric
+// socket interface index, when exposed, is the zone suffix of its IPv6 address.
+bool ReadHost(networking::IHostName* host,
+              NetworkInterfaceList& list,
+              std::map<std::string, uint32_t>& indices) {
+  networking::HostNameType kind;
+  if (FAILED(host->get_Type(&kind))) {
+    return false;
+  }
+  if (kind != networking::HostNameType_Ipv4 &&
+      kind != networking::HostNameType_Ipv6) {
+    return true;
+  }
+
+  ComPtr<IIPInformation> ip_info;
+  if (FAILED(host->get_IPInformation(&ip_info))) {
+    return false;
+  }
+  if (!ip_info) {
+    return true;
+  }
+
+  HSTRING raw_name = nullptr;
+  if (FAILED(host->get_CanonicalName(&raw_name))) {
+    return false;
+  }
+  std::string name = base::win::ScopedHString(raw_name).GetAsUTF8();
+  uint32_t index = 0;
+  size_t zone = name.find('%');
+  if (zone != std::string::npos) {
+    if (kind != networking::HostNameType_Ipv6 ||
+        !base::StringToUint(std::string_view(name).substr(zone + 1), &index)) {
+      return false;
+    }
+    name.resize(zone);
+  }
+  auto address = IPAddress::FromIPLiteral(name);
+  if (!address) {
+    return false;
+  }
+  if (address->IsLoopback() || address->IsZero()) {
+    return true;
+  }
+
+  ComPtr<INetworkAdapter> adapter;
+  GUID id;
+  ComPtr<__FIReference_1_byte> prefix;
+  BYTE length;
+  if (FAILED(ip_info->get_NetworkAdapter(&adapter)) || !adapter ||
+      FAILED(adapter->get_NetworkAdapterId(&id)) ||
+      FAILED(ip_info->get_PrefixLength(&prefix)) || !prefix ||
+      FAILED(prefix->get_Value(&length)) || length > address->size() * 8) {
+    return false;
+  }
+
+  auto guid = base::StringPrintf(
+      "{%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}", id.Data1, id.Data2,
+      id.Data3, id.Data4[0], id.Data4[1], id.Data4[2], id.Data4[3], id.Data4[4],
+      id.Data4[5], id.Data4[6], id.Data4[7]);
+  if (index) {
+    indices[guid] = index;
+  }
+  list.emplace_back(guid, guid, index, phone::AdapterType(adapter.Get()),
+                    *address, length, IP_ADDRESS_ATTRIBUTE_NONE);
+  return true;
+}
+}  // namespace
+
+bool GetNetworkList(NetworkInterfaceList* networks, int policy) {
+  phone::NetworkApartment apartment;
+  if (!apartment.ready()) {
+    return false;
+  }
+  auto info = phone::NetworkInformation();
+  ComPtr<__FIVectorView_1_Windows__CNetworking__CHostName> hosts;
+  unsigned int count;
+  if (!info || FAILED(info->GetHostNames(&hosts)) || !hosts ||
+      FAILED(hosts->get_Size(&count))) {
+    return false;
+  }
+
+  NetworkInterfaceList found;
+  std::map<std::string, uint32_t> indices;
+  bool entry_failed = false;
+  for (unsigned int i = 0; i < count; ++i) {
+    ComPtr<networking::IHostName> host;
+    if (FAILED(hosts->GetAt(i, &host)) || !host ||
+        !ReadHost(host.Get(), found, indices)) {
+      entry_failed = true;
+    }
+  }
+  if (entry_failed && found.empty()) {
+    return false;
+  }
+  for (auto& entry : found) {
+    auto it = indices.find(entry.name);
+    // An IPv6 zone is usable for IPv6 sockets. IPv4 can use a different
+    // index on Windows, so do not synthesize it from the IPv6 index.
+    if (entry.address.IsIPv6() && it != indices.end()) {
+      entry.interface_index = it->second;
+    }
+  }
+  networks->insert(networks->end(), found.begin(), found.end());
+  return true;
+}
+
+std::string GetWifiSSID() {
+  phone::NetworkApartment apartment;
+  if (!apartment.ready()) {
+    return {};
+  }
+  auto info = phone::NetworkInformation();
+  ComPtr<IConnectionProfile> profile;
+  ComPtr<IConnectionProfile2> profile2;
+  ComPtr<IWlanConnectionProfileDetails> wlan;
+  HSTRING ssid = nullptr;
+  if (!info || FAILED(info->GetInternetConnectionProfile(&profile)) ||
+      !profile || FAILED(profile.As(&profile2)) ||
+      FAILED(profile2->get_WlanConnectionProfileDetails(&wlan)) || !wlan ||
+      FAILED(wlan->GetConnectedSsid(&ssid))) {
+    return {};
+  }
+  return base::win::ScopedHString(ssid).GetAsUTF8();
+}
+
+std::unique_ptr<ScopedWifiOptions> SetWifiOptions(int options) {
+  // Desktop WLAN radio configuration is unavailable to phone applications.
+  return nullptr;
+}
+}  // namespace net
