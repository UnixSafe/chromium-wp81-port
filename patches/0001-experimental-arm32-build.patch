+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Included inside base::win. Windows Phone exposes WaitForMultipleObjectsEx
+// for Store apps but reserves RegisterWaitForSingleObject for desktop apps.
+class PhoneObjectWatch {
+ public:
+  PhoneObjectWatch(HANDLE duplicate,
+                   bool run_once,
+                   const Location& from_here,
+                   scoped_refptr<SequencedTaskRunner> runner,
+                   RepeatingClosure closure)
+      : handle(duplicate),
+        once(run_once),
+        location(from_here),
+        task_runner(std::move(runner)),
+        callback(std::move(closure)) {}
+
+  const ScopedHandle handle;
+  const bool once;
+  const Location location;
+  const scoped_refptr<SequencedTaskRunner> task_runner;
+  const RepeatingClosure callback;
+};
+
+class PhoneWaitGroup : public std::enable_shared_from_this<PhoneWaitGroup> {
+ public:
+  using Watch = std::shared_ptr<PhoneObjectWatch>;
+
+  static Watch Add(HANDLE source,
+                   bool once,
+                   const Location& from_here,
+                   scoped_refptr<SequencedTaskRunner> runner,
+                   RepeatingClosure closure) {
+    HANDLE duplicate = nullptr;
+    HANDLE process = ::GetCurrentProcess();
+    if (!::DuplicateHandle(process, source, process, &duplicate, SYNCHRONIZE,
+                           FALSE, 0)) {
+      return nullptr;
+    }
+    auto watch = std::make_shared<PhoneObjectWatch>(
+        duplicate, once, from_here, std::move(runner), std::move(closure));
+
+    auto& pool = GetPool();
+    AutoLock guard(pool.lock);
+    for (auto& group : pool.groups) {
+      if (group->watches_.size() < MAXIMUM_WAIT_OBJECTS - 1) {
+        group->watches_.push_back(watch);
+        PCHECK(::SetEvent(group->changed_.get()));
+        return watch;
+      }
+    }
+
+    auto group = std::make_shared<PhoneWaitGroup>();
+    if (!group->changed_.is_valid()) {
+      return nullptr;
+    }
+    group->watches_.push_back(watch);
+    ScopedHandle thread(
+        ::CreateThread(nullptr, 0, &ThreadMain, group.get(), 0, nullptr));
+    if (!thread.is_valid()) {
+      return nullptr;
+    }
+    pool.groups.push_back(std::move(group));
+    return watch;
+  }
+
+  static void Remove(const Watch& watch) {
+    auto& pool = GetPool();
+    AutoLock guard(pool.lock);
+    for (auto& group : pool.groups) {
+      if (std::erase(group->watches_, watch)) {
+        // Prioritize the control handle over signaled user events in an old
+        // snapshot. Snapshots own duplicated handles, so the caller may close
+        // the original as soon as StopWatching returns.
+        PCHECK(::SetEvent(group->changed_.get()));
+        return;
+      }
+    }
+    // A one-shot wait may already have queued its weak notification.
+  }
+
+ private:
+  struct Pool {
+    Lock lock;
+    std::vector<std::shared_ptr<PhoneWaitGroup>> groups;
+  };
+
+  static Pool& GetPool() {
+    static NoDestructor<Pool> pool;
+    return *pool;
+  }
+
+  static DWORD WINAPI ThreadMain(void* argument) {
+    auto* group = static_cast<PhoneWaitGroup*>(argument);
+    auto lifetime = group->shared_from_this();
+    lifetime->Run();
+    return 0;
+  }
+
+  void Run() {
+    auto& pool = GetPool();
+    for (;;) {
+      std::vector<Watch> snapshot;
+      {
+        AutoLock guard(pool.lock);
+        // Keep one sleeping worker for the next one-shot socket event. Spare
+        // workers retire when their last registration goes away.
+        if (watches_.empty() && pool.groups.front().get() != this) {
+          std::erase_if(pool.groups, [this](const auto& entry) {
+            return entry.get() == this;
+          });
+          return;
+        }
+        snapshot = watches_;
+        PCHECK(::ResetEvent(changed_.get()));
+      }
+
+      std::array<HANDLE, MAXIMUM_WAIT_OBJECTS> handles;
+      handles[0] = changed_.get();
+      for (size_t i = 0; i < snapshot.size(); ++i) {
+        handles[i + 1] = snapshot[i]->handle.get();
+      }
+      DWORD count = static_cast<DWORD>(snapshot.size() + 1);
+      DWORD result = ::WaitForMultipleObjectsEx(count, handles.data(), FALSE,
+                                                INFINITE, FALSE);
+      if (result == WAIT_OBJECT_0) {
+        continue;
+      }
+      PCHECK(result - WAIT_OBJECT_0 < count);
+      const Watch& ready = snapshot[result - WAIT_OBJECT_0 - 1];
+      {
+        AutoLock guard(pool.lock);
+        auto found = std::ranges::find(watches_, ready);
+        if (found == watches_.end()) {
+          continue;
+        }
+        if (ready->once) {
+          watches_.erase(found);
+        } else {
+          // Win32 selects the lowest index when several events are ready.
+          std::rotate(found, found + 1, watches_.end());
+        }
+      }
+      // The bound WeakPtr is evaluated on the owning sequence. StopWatching
+      // invalidates it even if this notification is already in that queue.
+      ready->task_runner->PostTask(ready->location, ready->callback);
+    }
+  }
+
+  ScopedHandle changed_{::CreateEventExW(nullptr,
+                                         nullptr,
+                                         CREATE_EVENT_MANUAL_RESET,
+                                         SYNCHRONIZE | EVENT_MODIFY_STATE)};
+  std::vector<Watch> watches_;
+};
