diff --git a/base/message_loop/message_pump_winuwp.inc b/base/message_loop/message_pump_winuwp.inc
new file mode 100644
index 0000000..bab63b6
--- /dev/null
+++ b/base/message_loop/message_pump_winuwp.inc
@@ -0,0 +1,185 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Included inside namespace base in message_pump_win.cc.
+namespace core = ABI::Windows::UI::Core;
+namespace threading = ABI::Windows::System::Threading;
+using Microsoft::WRL::Callback;
+using Microsoft::WRL::ComPtr;
+using Microsoft::WRL::Wrappers::HStringReference;
+
+struct MessagePumpForUI::DispatcherState
+    : std::enable_shared_from_this<DispatcherState> {
+  explicit DispatcherState(MessagePumpForUI* pump) : owner(pump) {
+    ComPtr<core::ICoreWindowStatic> factory;
+    HRESULT result = ::RoGetActivationFactory(
+        HStringReference(RuntimeClass_Windows_UI_Core_CoreWindow).Get(),
+        IID_PPV_ARGS(&factory));
+    // FrameworkView has initialized WinRT before Run. A worker with a
+    // Chromium UI pump need not have initialized an apartment.
+    if (result == CO_E_NOTINITIALIZED) {
+      return;
+    }
+    CHECK(SUCCEEDED(result));
+    ComPtr<core::ICoreWindow> window;
+    CHECK(SUCCEEDED(factory->GetForCurrentThread(&window)));
+    // A secondary Chromium UI thread can lack a CoreWindow.
+    if (window) {
+      CHECK(SUCCEEDED(window->get_Dispatcher(&dispatcher)));
+      CHECK(SUCCEEDED(::RoGetActivationFactory(
+          HStringReference(RuntimeClass_Windows_System_Threading_ThreadPoolTimer)
+              .Get(), IID_PPV_ARGS(&timers))));
+    }
+  }
+
+  void Wake() {
+    if (posted.exchange(true, std::memory_order_relaxed)) {
+      return;
+    }
+    auto callback = Callback<core::IDispatchedHandler>(
+        [weak = weak_from_this()]() -> HRESULT {
+          if (auto state = weak.lock()) {
+            state->posted.store(false, std::memory_order_relaxed);
+            if (state->owner) {
+              state->owner->HandleWorkMessage();
+            }
+          }
+          return S_OK;
+        });
+    ComPtr<ABI::Windows::Foundation::IAsyncAction> action;
+    CHECK(SUCCEEDED(dispatcher->RunAsync(core::CoreDispatcherPriority_Normal,
+                                         callback.Get(), &action)));
+  }
+
+  // Access owner and timer only on the owning UI thread.
+  raw_ptr<MessagePumpForUI> owner;
+  ComPtr<core::ICoreDispatcher> dispatcher;
+  ComPtr<threading::IThreadPoolTimerStatics> timers;
+  ComPtr<threading::IThreadPoolTimer> timer;
+  std::atomic_bool posted{false};
+};
+
+MessagePumpForUI::MessagePumpForUI()
+    : dispatcher_state_(std::make_shared<DispatcherState>(this)) {}
+
+MessagePumpForUI::~MessagePumpForUI() {
+  dispatcher_state_->owner = nullptr;
+  KillNativeTimer();
+}
+
+void MessagePumpForUI::ScheduleWork() {
+  if (dispatcher_state_->dispatcher) {
+    dispatcher_state_->Wake();
+  } else {
+    event_.Signal();
+  }
+}
+
+void MessagePumpForUI::KillNativeTimer() {
+  if (dispatcher_state_->timer) {
+    CHECK(SUCCEEDED(dispatcher_state_->timer->Cancel()));
+    dispatcher_state_->timer.Reset();
+  }
+  installed_native_timer_.reset();
+}
+
+void MessagePumpForUI::ScheduleNativeTimer(Delegate::NextWorkInfo next) {
+  if (installed_native_timer_ == next.delayed_run_time) {
+    return;
+  }
+  KillNativeTimer();
+  if (next.delayed_run_time.is_max()) {
+    return;
+  }
+  DWORD delay_ms = GetSleepTimeoutMs(next.delayed_run_time);
+  if (delay_ms == 0) {
+    ScheduleWork();
+    return;
+  }
+  auto elapsed = Callback<threading::ITimerElapsedHandler>(
+      [weak = dispatcher_state_->weak_from_this()](
+          threading::IThreadPoolTimer*) -> HRESULT {
+        if (auto state = weak.lock()) {
+          state->Wake();
+        }
+        return S_OK;
+      });
+  ABI::Windows::Foundation::TimeSpan interval{static_cast<int64_t>(delay_ms) * 10000};
+  CHECK(SUCCEEDED(dispatcher_state_->timers->CreateTimer(
+      elapsed.Get(), interval, &dispatcher_state_->timer)));
+  installed_native_timer_ = next.delayed_run_time;
+}
+
+void MessagePumpForUI::ScheduleDelayedWork(const Delegate::NextWorkInfo& next) {
+  if (in_nested_native_loop_with_application_tasks_) {
+    ScheduleNativeTimer(next);
+  }
+}
+
+bool MessagePumpForUI::HandleNestedNativeLoopWithApplicationTasks(bool allow) {
+  if (!dispatcher_state_->dispatcher) {
+    return false;
+  }
+  in_nested_native_loop_with_application_tasks_ = allow;
+  if (allow) {
+    ScheduleWork();
+  }
+  return true;
+}
+
+void MessagePumpForUI::HandleWorkMessage() {
+  if (run_state_ && !run_state_->should_quit &&
+      in_nested_native_loop_with_application_tasks_) {
+    KillNativeTimer();
+    auto next = run_state_->delegate->DoWork();
+    if (next.is_immediate()) {
+      ScheduleWork();
+    } else {
+      ScheduleNativeTimer(next);
+    }
+  }
+}
+
+void MessagePumpForUI::DoRunLoop() {
+  // WinRT does not expose individual messages. Instrument nonblocking dispatch
+  // batches only, so time spent asleep is not attributed to input handling.
+  auto dispatch_pending = [&] {
+    auto id = next_peek_message_event_id_++;
+    if (native_event_observer_) {
+      native_event_observer_->WillRunNativeEvent(id);
+    }
+    CHECK(SUCCEEDED(dispatcher_state_->dispatcher->ProcessEvents(
+        core::CoreProcessEventsOption_ProcessAllIfPresent)));
+    if (native_event_observer_) {
+      native_event_observer_->DidRunNativeEvent(id);
+    }
+  };
+  while (!run_state_->should_quit) {
+    if (dispatcher_state_->dispatcher) {
+      dispatch_pending();
+      if (run_state_->should_quit) {
+        break;
+      }
+    }
+    auto next = run_state_->delegate->DoWork();
+    if (run_state_->should_quit || next.is_immediate()) {
+      continue;
+    }
+    run_state_->delegate->DoIdleWork();
+    if (run_state_->should_quit) {
+      break;
+    }
+    run_state_->delegate->BeforeWait();
+    if (dispatcher_state_->dispatcher) {
+      ScheduleNativeTimer(next);
+      CHECK(SUCCEEDED(dispatcher_state_->dispatcher->ProcessEvents(
+          core::CoreProcessEventsOption_ProcessOneAndAllPending)));
+      KillNativeTimer();
+    } else if (next.delayed_run_time.is_max()) {
+      event_.Wait();
+    } else {
+      event_.TimedWait(next.delayed_run_time - TimeTicks::Now());
+    }
+  }
+}
